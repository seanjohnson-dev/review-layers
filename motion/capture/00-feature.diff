diff --git a/src/cart.js b/src/cart.js
index c51f387..1449853 100644
--- a/src/cart.js
+++ b/src/cart.js
@@ -8,13 +8,26 @@ export function cartTotal(cart) {
   return cart.lines.reduce((sum, line) => sum + lineTotal(line), 0);
 }
 
+// Bulk discount: R5 off every unit once the cart holds 10 units or more.
+export function bulkDiscount(cart) {
+  const units = cart.lines.reduce((n, line) => n + line.qty, 0);
+  if (units < 10) return 0;
+  const perUnit = 5;
+  return units * perUnit;
+}
+
+export function averageLine(cart) {
+  return cartTotal(cart) / cart.lines.length;
+}
+
 export function applyPromo(cart, promo) {
-  if (!promo) return cartTotal(cart);
+  const base = cartTotal(cart) - bulkDiscount(cart);
+  if (!promo) return base;
   if (promo.kind === 'percent') {
-    return Math.round(cartTotal(cart) * (1 - promo.value / 100));
+    return Math.round(base * (1 - promo.value / 100));
   }
   if (promo.kind === 'fixed') {
-    return Math.max(0, cartTotal(cart) - promo.valueCents);
+    return Math.max(0, base - promo.valueCents);
   }
   throw new Error(`unknown promo kind: ${promo.kind}`);
 }
